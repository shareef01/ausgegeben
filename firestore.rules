rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Email/password sign-up starts unverified. Prefer reads; require
    // verification before mutating preferences, transactions, or categories.
    function isEmailVerified() {
      return request.auth.token.email_verified == true;
    }

    // Account wipe marks meta/accountDeletion before deleting docs so unverified
    // owners can still finish deletion without opening mass-delete to raw clients.
    function accountDeletionPending(userId) {
      return exists(/databases/$(database)/documents/users/$(userId)/meta/accountDeletion)
        && get(/databases/$(database)/documents/users/$(userId)/meta/accountDeletion)
             .data.pendingDeletion == true;
    }

    function canDeleteOwned(userId) {
      return isOwner(userId) && (isEmailVerified() || accountDeletionPending(userId));
    }

    function validAnalyticsPeriod(p) {
      return p in ['all_time', 'this_month', 'last_month']
        || p.matches('^month:[0-9]{4}-(0[1-9]|1[0-2])$');
    }

    // 2000-01-01 .. 2100-01-01 UTC (exclusive end)
    function validDateMillis(ms) {
      return ms is number
        && ms >= 946684800000
        && ms < 4102444800000;
    }

    // Uncategorized sentinel (id "0") may hold any transactionType after
    // category delete reassignment; all other categories must match.
    function expenseCategoryTypeMatches(userId) {
      let catId = request.resource.data.categoryId;
      return catId == '0'
        || get(/databases/$(database)/documents/users/$(userId)/categories/$(catId))
             .data.transactionType == request.resource.data.transactionType;
    }

    // Fields written by builds that predate this allowlist. They are tolerated,
    // never required, and nothing reads them — but hasOnly() is evaluated against
    // the *merged* document, so excluding them made every row that carries one
    // permanently unwritable. On a real account that was 39 of 89 transactions:
    // uneditable, and worse, the orphan sweep's own repair write was rejected too,
    // so the app retried the same failing mutation on every launch forever.
    //
    // Bounded rather than waved through: without size limits an allowlisted field
    // is just free storage for anyone holding the public API key.
    // Measured against a real account rather than guessed: of 89 expenses, 22 store
    // receiptImagePath as null and 19 carry the cloudId/categoryCloudId pair. Null is
    // explicitly allowed — demanding `is string` here would have frozen 28 more rows
    // than it unfroze.
    function validLegacyExpenseFields(d) {
      return (!('cloudId' in d) || (d.cloudId is string && d.cloudId.size() < 128))
        && (!('categoryCloudId' in d)
          || d.categoryCloudId == null
          || (d.categoryCloudId is string && d.categoryCloudId.size() < 128)
          || d.categoryCloudId is number)
        && (!('receiptImagePath' in d)
          || d.receiptImagePath == null
          || (d.receiptImagePath is string && d.receiptImagePath.size() < 512))
        && (!('deleted' in d) || d.deleted is bool);
    }

    /**
     * updatedAt is a millisecond number today, but builds before that wrote a real
     * Firestore timestamp — 22 of 89 rows on the account this was found on. A
     * timestamp is not a number in rules, so requiring one made every such row
     * unwritable, including by the orphan sweep's own repair. Accept both.
     */
    function validUpdatedAt(d) {
      return !('updatedAt' in d) || d.updatedAt is number || d.updatedAt is timestamp;
    }

    function validExpense() {
      let d = request.resource.data;
      return d.keys().hasOnly([
          'amount', 'dateMillis', 'categoryId', 'note', 'transactionType',
          'updatedAt', 'idempotencyKey', 'id',
          'cloudId', 'categoryCloudId', 'receiptImagePath', 'deleted'
        ])
        && validLegacyExpenseFields(d)
        && d.keys().hasAll(['amount', 'dateMillis', 'categoryId', 'note', 'transactionType'])
        && d.amount is number
        && d.amount > 0
        && d.amount < 1000000000
        && validDateMillis(d.dateMillis)
        && d.categoryId is string
        && d.categoryId.size() > 0
        && d.categoryId.size() < 64
        && d.note is string
        // <= matches the clients' hard cap (web slice(0,2000), Android take(2000)):
        // an exactly-2000-char note is a legitimate write, not an overrun.
        && d.note.size() <= 2000
        && d.transactionType in ['expense', 'income', 'transfer']
        && validUpdatedAt(d)
        && (!('idempotencyKey' in d)
          || (d.idempotencyKey is string && d.idempotencyKey.size() < 128))
        && (!('id' in d) || (d.id is string && d.id.size() < 64));
    }

    function validCategory() {
      let d = request.resource.data;
      return d.keys().hasOnly([
          'name', 'iconName', 'colorInt', 'transactionType', 'sortOrder',
          'updatedAt', 'id'
        ])
        && d.keys().hasAll(['name', 'iconName', 'colorInt', 'transactionType', 'sortOrder'])
        && d.name is string
        && d.name.size() > 0
        // <= matches the clients' hard cap (web slice(0,80), Android take(80)).
        && d.name.size() <= 80
        && d.iconName is string
        && d.iconName.size() > 0
        && d.iconName.size() < 64
        && d.colorInt is number
        && d.colorInt >= -2147483648
        && d.colorInt <= 2147483647
        && d.transactionType in ['expense', 'income', 'transfer']
        && d.sortOrder is number
        && d.sortOrder >= 0
        && d.sortOrder < 10000
        && (!('updatedAt' in d) || d.updatedAt is number)
        && (!('id' in d) || (d.id is string && d.id.size() < 64));
    }

    // Records the one-time maintenance passes (category dedupe, orphaned-expense
    // sweep) so cold starts can skip them. Either may be written on its own, so
    // neither key is mandatory — but at least one has to be present.
    function validDedupeMarker() {
      let d = request.resource.data;
      return d.keys().hasOnly(['categoriesDeduped', 'ranAt', 'orphansScannedAt'])
        && d.keys().hasAny(['categoriesDeduped', 'orphansScannedAt'])
        && (!('categoriesDeduped' in d) || d.categoriesDeduped is bool)
        && (!('ranAt' in d) || d.ranAt is number)
        && (!('orphansScannedAt' in d) || d.orphansScannedAt is number);
    }

    // Written before irreversible wipe so a failed Auth delete cannot re-seed
    // an empty account. Allowed without email verification (wipe path).
    function validAccountDeletion() {
      let d = request.resource.data;
      return d.keys().hasOnly(['pendingDeletion', 'wipedAt'])
        && d.keys().hasAll(['pendingDeletion'])
        && d.pendingDeletion is bool
        && (!('wipedAt' in d) || d.wipedAt is number);
    }

    function validThemeMode(mode) {
      return mode in [
        'light', 'dark', 'system', 'amoled', 'midnight',
        'ocean', 'forest', 'sunset', 'lavender', 'soft_light'
      ];
    }

    function validPreferences() {
      let d = request.resource.data;
      return d.keys().hasOnly([
          'currency', 'locale', 'themeMode', 'dailyReminder',
          'reminderHour', 'reminderMinute', 'analyticsPeriod', 'updatedAt',
          'monthlyBudget', 'onboardingComplete'
        ])
        && d.keys().hasAll([
          'currency', 'locale', 'themeMode', 'dailyReminder',
          'reminderHour', 'reminderMinute', 'analyticsPeriod', 'updatedAt'
        ])
        && d.currency in ['EUR', 'USD', 'GBP', 'CHF']
        && d.locale in ['en', 'de']
        && d.themeMode is string
        && validThemeMode(d.themeMode)
        && d.dailyReminder is bool
        && d.reminderHour is number
        && d.reminderHour >= 0
        && d.reminderHour <= 23
        && d.reminderMinute is number
        && d.reminderMinute >= 0
        && d.reminderMinute <= 59
        && d.analyticsPeriod is string
        && validAnalyticsPeriod(d.analyticsPeriod)
        && d.updatedAt is number
        && d.updatedAt > 0
        // Block far-future LWW clocks; allow any past timestamp from real devices.
        && d.updatedAt < request.time.toMillis() + 86400000
        && (!('monthlyBudget' in d)
          || d.monthlyBudget == null
          || (d.monthlyBudget is number && d.monthlyBudget >= 0 && d.monthlyBudget < 1000000000))
        && (!('onboardingComplete' in d) || d.onboardingComplete is bool);
    }

    match /users/{userId} {
      allow read, write: if false;

      match /categories/{categoryId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && isEmailVerified()
          && validCategory();
        // Deletes require verification, except during account wipe after
        // meta/accountDeletion.pendingDeletion is set.
        allow delete: if canDeleteOwned(userId);
      }

      match /expenses/{expenseId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && isEmailVerified()
          && validExpense()
          && exists(/databases/$(database)/documents/users/$(userId)/categories/$(request.resource.data.categoryId))
          && expenseCategoryTypeMatches(userId);
        allow delete: if canDeleteOwned(userId);
      }

      // Prefs require verification like other mutations — blocks unverified
      // quota spam while still allowing local-only theme/locale until confirm.
      match /settings/{docId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && isEmailVerified()
          && docId == 'preferences'
          && validPreferences();
        allow delete: if canDeleteOwned(userId) && docId == 'preferences';
      }

      match /meta/{docId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && (
            (docId == 'dedupe' && isEmailVerified() && validDedupeMarker())
            || (docId == 'accountDeletion' && validAccountDeletion())
          );
        allow delete: if canDeleteOwned(userId)
          && (docId == 'dedupe' || docId == 'accountDeletion');
      }
    }
  }
}
