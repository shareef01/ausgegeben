rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Email/password sign-up starts unverified. Prefer reads; require
    // verification before mutating preferences, transactions, or categories.
    function isEmailVerified() {
      return request.auth.token.email_verified == true;
    }

    // Spark-plan account deletion is client-driven. Require recent credential
    // proof independently at the Firestore boundary before arming the write freeze.
    function hasRecentAuthentication() {
      return isSignedIn()
        && request.auth.token.auth_time is int
        && request.auth.token.auth_time * 1000 >= request.time.toMillis() - 300000
        && request.auth.token.auth_time * 1000 <= request.time.toMillis() + 60000;
    }

    // Account wipe marks meta/accountDeletion before deleting docs. Once armed, the
    // marker freezes every ordinary create/update so a second tab/device cannot race
    // a new record in after the wipe's final collection scan.
    function accountDeletionPending(userId) {
      return exists(/databases/$(database)/documents/users/$(userId)/meta/accountDeletion)
        && get(/databases/$(database)/documents/users/$(userId)/meta/accountDeletion)
             .data.pendingDeletion == true;
    }

    function accountAcceptsWrites(userId) {
      // The marker's mere existence is the lock — not its field values — which also
      // avoids evaluating get().data for a missing document (Firestore Rules treats
      // that as an evaluation error, not an empty map). This tombstone is permanent
      // (see the meta/{docId} block below): no client can ever remove it once created,
      // by design (DOC-4/DOC-5) — there is no "keep the account" path that clears it.
      return !exists(/databases/$(database)/documents/users/$(userId)/meta/accountDeletion);
    }

    function canDeleteOwned(userId) {
      return isOwner(userId) && (isEmailVerified() || accountDeletionPending(userId));
    }

    function validAnalyticsPeriod(p) {
      return p in ['all_time', 'this_month', 'last_month']
        || p.matches('^month:[0-9]{4}-(0[1-9]|1[0-2])$');
    }

    // 2000-01-01 .. 2100-01-01 UTC (exclusive end)
    function validDateMillis(ms) {
      return ms is number
        && ms >= 946684800000
        && ms < 4102444800000;
    }

    // Uncategorized sentinel (id "0") may hold any transactionType after
    // category delete reassignment; all other categories must match.
    function expenseCategoryTypeMatches(userId) {
      let catId = request.resource.data.categoryId;
      let cat = get(/databases/$(database)/documents/users/$(userId)/categories/$(catId));
      let migrationState = cat.data.get('migrationState', '');
      let pendingType = cat.data.get('pendingTransactionType', '');
      return catId == '0'
        || cat.data.transactionType == request.resource.data.transactionType
        || (migrationState == 'migrating'
          && pendingType == request.resource.data.transactionType);
    }

    // A category in the deletion protocol remains readable for recovery, but no
    // current or old client may attach a new expense after the barrier is raised.
    // Missing means active for every historical category document.
    function expenseCategoryAcceptsReferences(userId) {
      let cat = get(/databases/$(database)/documents/users/$(userId)/categories/$(request.resource.data.categoryId));
      return !('deletionState' in cat.data) || cat.data.deletionState != 'deleting';
    }

    // Fields written by builds that predate this allowlist. They are tolerated,
    // never required, and nothing reads them — but hasOnly() is evaluated against
    // the *merged* document, so excluding them made every row that carries one
    // permanently unwritable. On a real account that was 39 of 89 transactions:
    // uneditable, and worse, the orphan sweep's own repair write was rejected too,
    // so the app retried the same failing mutation on every launch forever.
    //
    // Bounded rather than waved through: without size limits an allowlisted field
    // is just free storage for anyone holding the public API key.
    // Measured against a real account rather than guessed: of 89 expenses, 22 store
    // receiptImagePath as null and 19 carry the cloudId/categoryCloudId pair. Null is
    // explicitly allowed — demanding `is string` here would have frozen 28 more rows
    // than it unfroze.
    function validLegacyExpenseFields(d) {
      return (!('cloudId' in d) || (d.cloudId is string && d.cloudId.size() < 128))
        && (!('categoryCloudId' in d)
          || d.categoryCloudId == null
          || (d.categoryCloudId is string && d.categoryCloudId.size() < 128)
          || d.categoryCloudId is number)
        && (!('receiptImagePath' in d)
          || d.receiptImagePath == null
          || (d.receiptImagePath is string && d.receiptImagePath.size() < 512))
        && (!('deleted' in d) || d.deleted is bool);
    }

    /**
     * updatedAt is a millisecond number today, but builds before that wrote a real
     * Firestore timestamp — 22 of 89 rows on the account this was found on. A
     * timestamp is not a number in rules, so requiring one made every such row
     * unwritable, including by the orphan sweep's own repair. Accept both.
     */
    function validUpdatedAt(d) {
      // Keep both historical representations writable, but do not let a custom
      // client pin conflict/migration metadata arbitrarily far into the future.
      // A five-minute allowance is generous enough for offline writes produced by
      // a normally skewed device clock; old offline writes have no lower bound.
      return !('updatedAt' in d)
        || (d.updatedAt is number
          && d.updatedAt <= request.time.toMillis() + 300000)
        || (d.updatedAt is timestamp
          && d.updatedAt.toMillis() <= request.time.toMillis() + 300000);
    }

    function validExpense() {
      let d = request.resource.data;
      return d.keys().hasOnly([
          'amount', 'dateMillis', 'categoryId', 'note', 'transactionType',
          'updatedAt', 'idempotencyKey', 'id',
          'cloudId', 'categoryCloudId', 'receiptImagePath', 'deleted'
        ])
        && validLegacyExpenseFields(d)
        && d.keys().hasAll(['amount', 'dateMillis', 'categoryId', 'note', 'transactionType'])
        && d.amount is number
        && d.amount > 0
        && d.amount < 1000000000
        // Currency values are cent-granular. This is enforced at the trust boundary,
        // so a raw Firebase client cannot inject sub-cent values that make totals and
        // exports disagree after floating-point accumulation.
        && math.abs(d.amount * 100 - math.round(d.amount * 100)) < 0.0001
        && validDateMillis(d.dateMillis)
        && d.categoryId is string
        && d.categoryId.size() > 0
        && d.categoryId.size() < 64
        && d.note is string
        // <= matches the clients' hard cap (web slice(0,2000), Android take(2000)):
        // an exactly-2000-char note is a legitimate write, not an overrun.
        && d.note.size() <= 2000
        && d.transactionType in ['expense', 'income', 'transfer']
        && validUpdatedAt(d)
        && (!('idempotencyKey' in d)
          || (d.idempotencyKey is string && d.idempotencyKey.size() < 128))
        && (!('id' in d) || (d.id is string && d.id.size() <= 64));
    }

    function preservesExpenseIdempotencyKey() {
      return ('idempotencyKey' in resource.data)
        ? ('idempotencyKey' in request.resource.data
            && request.resource.data.idempotencyKey == resource.data.idempotencyKey)
        : !('idempotencyKey' in request.resource.data);
    }

    // Categories came from the same legacy backend as expenses and carry the same
    // drift, just never audited for it until reorder started failing live:
    // `cloudId` (their own legacy id) and `deleted`, plus updatedAt stored as a
    // real Timestamp on any category written before that became a plain number.
    // Checked against a real 17-category account rather than guessed: 12 of 17
    // carry cloudId, all 12 of those have a Timestamp updatedAt, one has `deleted`.
    // hasOnly() sees the merged document, so leaving any of this out made every
    // one of those rows permanently unwritable — including by moveCategory, which
    // touches every category in a type on every reorder.
    function validLegacyCategoryFields(d) {
      return (!('cloudId' in d) || (d.cloudId is string && d.cloudId.size() < 128))
        && (!('deleted' in d) || d.deleted is bool);
    }

    function validCategory() {
      let d = request.resource.data;
      return d.keys().hasOnly([
          'name', 'iconName', 'colorInt', 'transactionType', 'sortOrder',
          'updatedAt', 'id', 'cloudId', 'deleted', 'deletionState',
          'migrationState', 'pendingTransactionType'
        ])
        && validLegacyCategoryFields(d)
        && d.keys().hasAll(['name', 'iconName', 'colorInt', 'transactionType', 'sortOrder'])
        && d.name is string
        && d.name.size() > 0
        // <= matches the clients' hard cap (web slice(0,80), Android take(80)).
        && d.name.size() <= 80
        && d.iconName is string
        && d.iconName.size() > 0
        && d.iconName.size() < 64
        && d.colorInt is number
        && d.colorInt >= -2147483648
        && d.colorInt <= 2147483647
        && d.transactionType in ['expense', 'income', 'transfer']
        && d.sortOrder is number
        && d.sortOrder >= 0
        && d.sortOrder < 10000
        && validUpdatedAt(d)
        && (!('deletionState' in d) || d.deletionState == 'deleting')
        && (
          (!('migrationState' in d) && !('pendingTransactionType' in d))
          || (d.get('migrationState', '') == 'migrating'
            && d.get('pendingTransactionType', '') in ['expense', 'income', 'transfer']
            && d.get('pendingTransactionType', '') != d.transactionType)
        )
        && (!('id' in d) || (d.id is string && d.id.size() < 64));
    }

    // A type change must be staged before linked expenses move and can only publish
    // the staged target. This prevents raw clients (and stale official clients) from
    // silently flipping the category while leaving every linked expense inconsistent.
    function validCategoryCreate() {
      return validCategory()
        && !('migrationState' in request.resource.data)
        && !('pendingTransactionType' in request.resource.data);
    }

    function validCategoryUpdate() {
      let before = resource.data;
      let after = request.resource.data;
      let beforeMigrating = before.get('migrationState', '') == 'migrating';
      let afterMigrating = after.get('migrationState', '') == 'migrating';
      return validCategory() && (
        // Ordinary rename/style/order/deletion-state updates cannot change type.
        (!beforeMigrating && !afterMigrating
          && after.transactionType == before.transactionType)
        // Start a migration without changing the published type.
        || (!beforeMigrating && afterMigrating
          && after.transactionType == before.transactionType)
        // Retrying/resuming must preserve the exact staged transition.
        || (beforeMigrating && afterMigrating
          && after.transactionType == before.transactionType
          && after.pendingTransactionType == before.pendingTransactionType)
        // Finalization may publish only the previously staged target.
        || (beforeMigrating && !afterMigrating
          && after.transactionType == before.pendingTransactionType)
      );
    }

    // Records the one-time maintenance passes (category dedupe, orphaned-expense
    // sweep) so cold starts can skip them. Either may be written on its own, so
    // neither key is mandatory — but at least one has to be present.
    // `orphanScanVersion` records *which* sweep ran, not merely that one did. Gating on
    // the mere presence of orphansScannedAt is what made a shipped repair unrunnable once:
    // the marker was already set on every account that had cold-started, so the new
    // cleanup could never fire on the accounts that needed it. Bounded like every other
    // client-written number here.
    function validDedupeMarker() {
      let d = request.resource.data;
      return d.keys().hasOnly([
          'categoriesDeduped', 'ranAt', 'orphansScannedAt',
          'orphanRepairScanTruncated', 'orphanScanVersion',
          'orphanRepairState', 'orphanRepairCursorId',
          'orphanRepairTargetVersion', 'orphanRepairUnfixable',
          'orphanRepairUpdatedAt'
        ])
        && d.keys().hasAny(['categoriesDeduped', 'orphansScannedAt', 'orphanRepairState'])
        && (!('categoriesDeduped' in d) || d.categoriesDeduped is bool)
        && (!('ranAt' in d) || d.ranAt is number)
        && (!('orphansScannedAt' in d) || d.orphansScannedAt is number)
        && (!('orphanRepairScanTruncated' in d) || d.orphanRepairScanTruncated is bool)
        && (!('orphanRepairState' in d)
          || d.orphanRepairState in ['running', 'complete', 'complete_with_errors'])
        && (!('orphanRepairCursorId' in d)
          || (d.orphanRepairCursorId is string && d.orphanRepairCursorId.size() > 0
            && d.orphanRepairCursorId.size() < 256))
        && (!('orphanRepairTargetVersion' in d)
          || (d.orphanRepairTargetVersion is int && d.orphanRepairTargetVersion >= 0
            && d.orphanRepairTargetVersion < 1000000))
        && (!('orphanRepairUnfixable' in d)
          || (d.orphanRepairUnfixable is int && d.orphanRepairUnfixable >= 0))
        && (!('orphanRepairUpdatedAt' in d) || d.orphanRepairUpdatedAt is number)
        && (!('orphanScanVersion' in d)
          || (d.orphanScanVersion is int
            && d.orphanScanVersion >= 0
            && d.orphanScanVersion < 1000000));
    }

    function validAccountDeletion() {
      let d = request.resource.data;
      return d.keys().hasOnly(['pendingDeletion', 'state', 'startedAt'])
        && d.keys().hasAll(['pendingDeletion', 'state', 'startedAt'])
        && d.pendingDeletion == true
        && d.state == 'deleting'
        && d.startedAt is number
        && d.startedAt >= request.time.toMillis() - 300000
        && d.startedAt <= request.time.toMillis() + 60000;
    }

    function validThemeMode(mode) {
      return mode in [
        'light', 'dark', 'system', 'amoled', 'midnight',
        'ocean', 'forest', 'sunset', 'lavender', 'soft_light'
      ];
    }

    function validPreferences() {
      let d = request.resource.data;
      return d.keys().hasOnly([
          'currency', 'locale', 'themeMode', 'dailyReminder',
          'reminderHour', 'reminderMinute', 'analyticsPeriod', 'updatedAt',
          'monthlyBudget', 'onboardingComplete'
        ])
        && d.keys().hasAll([
          'currency', 'locale', 'themeMode', 'dailyReminder',
          'reminderHour', 'reminderMinute', 'analyticsPeriod', 'updatedAt'
        ])
        && d.currency in ['EUR', 'USD', 'GBP', 'CHF']
        && d.locale in ['en', 'de']
        && d.themeMode is string
        && validThemeMode(d.themeMode)
        && d.dailyReminder is bool
        && d.reminderHour is int
        && d.reminderHour >= 0
        && d.reminderHour <= 23
        && d.reminderMinute is int
        && d.reminderMinute >= 0
        && d.reminderMinute <= 59
        && d.analyticsPeriod is string
        && validAnalyticsPeriod(d.analyticsPeriod)
        && d.updatedAt is number
        && d.updatedAt > 0
        // Bound clock-skew abuse: a raw client cannot pin preferences far ahead.
        && d.updatedAt < request.time.toMillis() + 300000
        && (!('monthlyBudget' in d)
          || d.monthlyBudget == null
          || (d.monthlyBudget is number && d.monthlyBudget >= 0 && d.monthlyBudget < 1000000000))
        && (!('onboardingComplete' in d) || d.onboardingComplete is bool);
    }

    match /users/{userId} {
      allow read, write: if false;

      match /categories/{categoryId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && accountAcceptsWrites(userId)
          && isEmailVerified()
          && validCategoryCreate();
        allow update: if isOwner(userId)
          && accountAcceptsWrites(userId)
          && isEmailVerified()
          && validCategoryUpdate();
        // Deletes require verification, except during account wipe after
        // meta/accountDeletion.pendingDeletion is set.
        allow delete: if canDeleteOwned(userId)
          && (accountDeletionPending(userId) || resource.data.deletionState == 'deleting');
      }

      match /expenses/{expenseId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && accountAcceptsWrites(userId)
          && isEmailVerified()
          && validExpense()
          && exists(/databases/$(database)/documents/users/$(userId)/categories/$(request.resource.data.categoryId))
          && expenseCategoryAcceptsReferences(userId)
          && expenseCategoryTypeMatches(userId);
        allow update: if isOwner(userId)
          && accountAcceptsWrites(userId)
          && isEmailVerified()
          && validExpense()
          && preservesExpenseIdempotencyKey()
          && exists(/databases/$(database)/documents/users/$(userId)/categories/$(request.resource.data.categoryId))
          && expenseCategoryAcceptsReferences(userId)
          && expenseCategoryTypeMatches(userId);
        allow delete: if canDeleteOwned(userId);
      }

      // Prefs require verification like other mutations — blocks unverified
      // quota spam while still allowing local-only theme/locale until confirm.
      match /settings/{docId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && accountAcceptsWrites(userId)
          && isEmailVerified()
          && docId == 'preferences'
          && validPreferences();
        // Backend-enforced monotonicity is the final defense against delayed offline
        // writes and custom clients. Official clients also use read/write transactions
        // so a losing local candidate immediately adopts the committed winner.
        allow update: if isOwner(userId)
          && accountAcceptsWrites(userId)
          && isEmailVerified()
          && docId == 'preferences'
          && validPreferences()
          && request.resource.data.updatedAt > resource.data.updatedAt;
        allow delete: if canDeleteOwned(userId) && docId == 'preferences';
      }

      match /meta/{docId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && docId == 'dedupe'
          && accountAcceptsWrites(userId)
          && isEmailVerified()
          && validDedupeMarker();
        allow update: if isOwner(userId)
          && docId == 'dedupe'
          && accountAcceptsWrites(userId)
          && isEmailVerified()
          && validDedupeMarker();
        allow delete: if docId == 'dedupe' && canDeleteOwned(userId);
        // May be armed or retried only immediately after reauthentication. There is
        // deliberately no client delete permission: the tombstone is permanent.
        allow create, update: if isOwner(userId)
          && docId == 'accountDeletion'
          && hasRecentAuthentication()
          && validAccountDeletion();
      }
    }
  }
}
