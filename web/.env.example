VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# App Check (reCAPTCHA Enterprise site key from Firebase Console → App Check).
# Required for production builds when Firebase is configured (vite + runtime).
# Dev can omit it; add before enforcing App Check for Auth/Firestore in the Console.
# Also restrict the Web API key by HTTP referrer when ready.
VITE_FIREBASE_APP_CHECK_KEY=

# Crash reports POST here (see tools/error-endpoint/README.md). Optional:
# unset (the default for local builds) means errors stay console-only.
# The host must also be added to connect-src in the root firebase.json CSP.
VITE_ERROR_REPORT_URL=
