VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# App Check (reCAPTCHA Enterprise site key from Firebase Console → App Check).
# Required for production builds (getFirebaseApp throws if missing in PROD).
# Leave empty for local `npm run dev` / emulator mode only.
# Also enforce App Check for Authentication + Cloud Firestore in the Console
# (Monitor → Enforce) and restrict the Web API key by HTTP referrer.
# VITE_FIREBASE_APP_CHECK_KEY=
