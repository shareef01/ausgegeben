# Copy to keystore.properties (gitignored) or set AUSGEGEBEN_* env vars in CI.
# Keep the keystore OUTSIDE this repository and use an absolute path (forward slashes
# work on Windows). Relative paths resolve against the repo root, and the build warns
# when the keystore is inside the project folder.
storeFile=C:/Users/you/keystores/ausgegeben-release.jks
storePassword=
keyAlias=ausgegeben
keyPassword=
